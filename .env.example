# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and configure your local/production settings
# NEVER commit real credentials or secrets to GitHub!
# ==============================================================================

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/sanjay_portfolio?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Security
# Generate a secure 256-bit (32+ character) secret for production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Initial Admin Credentials (auto-seeded on first run if database is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminPassword123!

# Server & CORS
SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173

# Optional: External Services (configured for project features)
GEMINI_API_KEY=your_gemini_api_key_here
EMAIL_USERNAME=
EMAIL_PASSWORD=
